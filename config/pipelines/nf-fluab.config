process {

    withName: CONCAT_CONSENSUS {
        ext.prefix = { "all_consensus" }
        //ext.dir = 'report'
        publishDir = [
            [
                path: { "${params.outdir}/report" },
                mode: 'copy',
            ],
            [
                path: { "${params.outdir}/consensus" },
                mode: 'copy',
            ],
            [
                path: { "${params.outdir}/../master_report" },
                mode: 'copy',
            ],
        ]

    }

     withName: AGG_NEXTCLADE_HA_NA {

        publishDir = [
            [
                path: { "${params.outdir}/report" },
                mode: 'copy',
            ],
            [
                path: { "${params.outdir}/nextclade" },
                mode: 'copy',
            ],
            [
                path: { "${params.outdir}/../master_report" },
                mode: 'copy',
            ]
        ]

    }

}

params {
    config_profile_name        = 'nf-fluab config for flu-analyzer'
    config_profile_description = 'config for flu-analyzer'
}
